; Engine configuration file.
; Call of Survival: Front - a 3 x 3 km test slice (Godot 4.7)

config_version=5

[application]

config/name="Call of Survival: Front"
config/name_localized={
"ar": "نداء البقاء: الجبهة"
}
config/description="Bodycam test slice: a burnt pine forest front line with trenches, dugouts and craters."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.05, 0.05, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"
driver/output_latency=50

[autoload]

Settings="*res://scripts/settings.gd"
Sfx="*res://scripts/sfx.gd"
Online="*res://scripts/online.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=2048
environment/defaults/default_clear_color=Color(0.42, 0.44, 0.46, 1)
anti_aliasing/quality/msaa_3d=0
scaling_3d/mode=0
scaling_3d/scale=1.0
mesh_lod/lod_change/threshold_pixels=1.5
limits/opengl/max_lights_per_object=16

[shader_globals]

wind={
"type": "vec4",
"value": Vector4(1, 0.3, 0.6, 0)
}
wetness={
"type": "float",
"value": 0.0
}
rain={
"type": "float",
"value": 0.0
}
view_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
